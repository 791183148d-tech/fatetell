# ═══════════════════════════════════════════════════════════════
# FateTell — Configuration
# Copy this to .env and fill in your keys
# ═══════════════════════════════════════════════════════════════

# ── LLM API (at least one required for AI-generated reports) ──
# Get Claude key: https://console.anthropic.com/
CLAUDE_API_KEY=
# Alternative: DeepSeek
DEEPSEEK_API_KEY=

# ── Stripe (optional — without it, runs in demo/free mode) ────
# Get test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Get from: https://dashboard.stripe.com/webhooks (endpoint secret)
STRIPE_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-in-production
SITE_URL=http://localhost:5050
REPORT_PRICE=29.99
PORT=5050
